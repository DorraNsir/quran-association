# NestJS API (global prefix /api). Inlined at build time for the browser.
# Vercel: set it in Project → Settings → Environment Variables (e.g. https://<api>.up.railway.app/api),
# then redeploy — a change needs a new build.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Optional: the same API as reached from the Next.js server (server-rendered public pages)
# API_INTERNAL_URL=http://localhost:4000/api
