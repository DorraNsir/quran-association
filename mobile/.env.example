# Base URL of the existing NestJS API, including the /api prefix.
# Copy to .env.local (git-ignored) and adjust.
#
# A phone or emulator cannot reach "localhost" on your computer:
#   - Android emulator : http://10.0.2.2:4000/api
#   - iOS simulator    : http://localhost:4000/api
#   - Physical device  : http://<your-computer-LAN-IP>:4000/api
#   - Production       : https://<api-domain>/api   (HTTPS required)
#EXPO_PUBLIC_API_URL=http://localhost:4000/api
EXPO_PUBLIC_API_URL=http://192.168.1.19:4000/api