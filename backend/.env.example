# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
# API port (the Next.js frontend uses 3000)
PORT=4000
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/quran_platform_dev"

# Origin(s) of the Next.js app, comma-separated (CORS with credentials + cookie endpoints)
FRONTEND_URL=http://localhost:3000

# ── Authentication ──
# Long random secret (≥ 32 chars), e.g. `openssl rand -base64 48`. Different per environment.
JWT_ACCESS_SECRET=change-me-generate-a-long-random-secret
# Access JWT lifetime (s|m|h|d)
JWT_ACCESS_EXPIRES_IN=15m
# Refresh session lifetime, renewed at each rotation (opaque token in an HttpOnly cookie)
REFRESH_TOKEN_EXPIRES_IN=7d
# lax: frontend and API on the same site (localhost, app./api. of one domain); none: cross-site (forces Secure)
REFRESH_COOKIE_SAMESITE=lax

# ── Attendance ──
# Days (today included) a teacher may record/correct attendance of their sessions (1–366; admins unlimited)
TEACHER_ATTENDANCE_WINDOW_DAYS=7

# ── Development seed account (optional, ignored when NODE_ENV=production) ──
# `npm run db:seed` creates this ADMIN account once if both are set. Choose your own values.
DEV_SEED_ADMIN_USERNAME=
DEV_SEED_ADMIN_PASSWORD=

# ── E2E tests (npm run test:e2e) ──
# Dedicated, disposable database: name must end with "_test", must differ from
# DATABASE_URL and be local (E2E_ALLOW_REMOTE_DB=true to override). It is
# created if missing and migrated with `prisma migrate deploy` before the suites.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/quran_platform_test"
